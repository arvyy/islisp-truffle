(requires "testing.lisp")

(defglobal builtin-classes
    (vector
        (class <arithmetic-error>)
        (class <floating-point-underflow>)
        (class <simple-error>)
        (class <basic-array>)
        (class <function>)
        (class <standard-generic-function>)
        (class <basic-array*>)
        (class <general-array*>)
        (class <standard-object>)
        (class <basic-vector>)
        (class <general-vector>)
        (class <storage-exhausted>)
        (class <character>)
        (class <generic-function>)
        (class <stream>)
        (class <cons>)
        (class <integer>)
        (class <stream-error>)
        (class <control-error>)
        (class <list>)
        (class <string>)
        (class <division-by-zero>)
        (class <null>)
        (class <symbol>)
        (class <domain-error>)
        (class <number>)
        (class <unbound-variable>)
        (class <end-of-stream>)
        (class <object>)
        (class <undefined-entity>)
        (class <error>)
        (class <parse-error>)
        (class <undefined-function>)
        (class <float>)
        (class <program-error>)
        (class <floating-point-overflow>)
        (class <serious-condition>)))

(for ((i 0 (+ i 1)))
     ((>= i (length builtin-classes)) nil)
  (let* ((cls (elt builtin-classes i))
         (metacls (class-of cls)))
    (if (and 
            (not (equal (class <built-in-class>) metacls))
            (not (equal (class <standard-class>) metacls)))
        (format (standard-output) "Metaclass of ~A is neither <built-in-class> or <standard-class>; was: ~A~%" cls metacls))))

(format (standard-output) "metaclass.lisp end")
(finish-output (standard-output))
